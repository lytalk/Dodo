<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dodo" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#121714</item>
        <item name="android:navigationBarColor">#121714</item>
        <item name="android:windowBackground">#121714</item>
    </style>

    <style name="Theme.Dodo.Wake" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
</resources>
